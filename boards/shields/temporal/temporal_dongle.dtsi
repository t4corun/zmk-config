#include "temporal.dtsi"

/ {
    /*
     * mock scan
     *   there is no temporal_seeedxiao because the dongle uses mock scan
     */

    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&trackpad_split {
    status = "okay";
};

&trackpad_listener {
    status = "okay";
};
