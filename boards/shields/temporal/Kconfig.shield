config SHIELD_TEMPORAL_LEFT
    def_bool \
        $(shields_list_contains,temporal_dongleleft) || \
        $(shields_list_contains,temporal_prospectorleft)

config SHIELD_TEMPORAL_RIGHT
    def_bool \
        $(shields_list_contains,temporal_dongleright) || \
        $(shields_list_contains,temporal_prospectorright)

config SHIELD_TEMPORAL_DONGLE
    def_bool \
        $(shields_list_contains,temporal_dongle) || \
        $(shields_list_contains,temporal_prospector)
