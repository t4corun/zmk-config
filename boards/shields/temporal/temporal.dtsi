#include <dt-bindings/zmk/matrix_transform.h>

/ {
    /*
     * matrix scan
     */

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Temporal keyboard matrix layout (42-key version)
     *
     * Notes:
     * - rows
     *   - 0 = top
     *   - 1 = home
     *   - 2 = bottom
     *   - 3 = thumb
     * - columns
     *   - 0, 11 = breakable outer column (extra key)
     *   - 1, 10 = pinky
     *   - 2,  9 = ring
     *   - 3,  8 = middle
     *   - 4,  7 = index
     *   - 5,  6 = inner
     * - RC(3,2) and RC(3,9) can either be a switch or an encoder
     */

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
                    RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                            RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    /*
     * Encoder configuration
     *
     *   steps = 24 PPR x 4 quadrature transitions per pulse = 96
     *
     *   Pins are defined in the left and right overlay because the
     *   perpiherals use a Nice!Nano and the central uses Seeed Xiao BLE
     */

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        steps = <96>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        steps = <96>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };


    /*
     * Trackpad Configuration configuration
     */

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad_split>;
        status = "disabled";
    };
};
