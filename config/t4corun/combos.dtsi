/*
 * Position definition for combos
 *
 * focused on base 3x5x3 configuration
 *
 *   ╭─────────────────────┬─────────────────────╮
 *   │ LT4 LT3 LT2 LT1 LT0 │ RT0 RT1 RT2 RT3 RT4 │
 *   │ LM4 LM3 LM2 LM1 LM0 │ RM0 RM1 RM2 RM3 RM4 │
 *   │ LB4 LB3 LB2 LB1 LB0 │ RB0 RB1 RB2 RB3 RB4 │
 *   ╰───────╮ LH2 LH1 LH0 │ RH0 RH1 RH2 ╭───────╯
 *           ╰─────────────┴─────────────╯
 */

// left side combos
COMBO_MACRO(
    escape,
    LT4 LT3,
    _TYPINGLAYERS,
    &kp ESC
)

COMBO_MACRO(
    tab,
    LB2 LB1,
    _TYPINGLAYERS _NUMBER,
    &kp TAB
)

COMBO_MACRO(
    at,
    LM1 LM0,
    _TYPINGLAYERS,
    &kp AT
)

COMBO_MACRO(
    function,
    LH1 LH0,
    _TYPINGLAYERS,
    FUNCTION
)


// right side combos
COMBO_MACRO(
    repeat,
    RM0 RM1,
    _TYPINGLAYERS,
    &key_repeat
)

COMBO_MACRO(
    enter,
    RB1 RB2,
    _TYPINGLAYERS,
    &kp ENTER
)

COMBO_MACRO(
    equal,
    RM0 RM1,
    _NUMBER,
    &kp EQUAL
)

// both sides
COMBO_MACRO(
    capsword,
    LH0 RH0,
    _TYPINGLAYERS,
    &caps_word
)

COMBO_MACRO(
    numword,
    LH2 RH2,
    _TYPINGLAYERS,
    &num_word _NUMBER
)
