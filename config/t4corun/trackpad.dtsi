#include <input/processors.dtsi>

/ {
    trackpad_behaviors {
//        swipe_button_mapper: swipe_button_mapper {
//            compatible = "zmk,input-processor-behaviors";
//            #input-processor-cells = <0>;
//            codes = <INPUT_BTN_NORTH INPUT_BTN_EAST INPUT_BTN_SOUTH INPUT_BTN_WEST>;
//            bindings = <&kp LG(TAB)>, <&kp LG(RIGHT)>, <&kp LG(D)>, <&kp LG(LEFT)>;
//        };

//        zip_zoom_mapper: zip_zoom_mapper {
//            compatible = "zmk,input-processor-zoom";
//            #input-processor-cells = <0>;
//            event-code = <INPUT_REL_MISC>;
//            sensitivity = <10>;
//            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
//            track-remainders;
//        };

        zip_zoom_to_wheel: zip_zoom_to_wheel {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            map = <INPUT_REL_MISC INPUT_REL_WHEEL>;
        };

        is_touching_processor:is_touching_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;

            codes = <INPUT_BTN_TOUCH>;      // watch for the 'touch' pseudo button
            bindings  = <&mo _NUMBER>;      // Activate Number layer during touch
        };
    };
};

&trackpad_listener {
    input-processors =  //<&zip_zoom_to_wheel>,
                        //<&swipe_button_mapper>,
                        <&zip_xy_scaler 1 1>,
                        <&zip_scroll_scaler 1 15>,
                        <&zip_scroll_transform  INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT>, // match phone and laptop
                        <&is_touching_processor>,
                        <&zip_zoom_to_wheel>;

};


